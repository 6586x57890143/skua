{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "skua-invite",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  // The Discord application ID is public; it is in every invite link.
  "vars": { "APP_ID": "1555546158426755102" },
  // skua.lol and melting.lol are zones on this account; a custom_domain creates
  // DNS and the cert. skua.melting.lol is the old home, kept so links already
  // posted still land. Its explicit route outranks melting.lol's dashboard-only
  // wildcard `*.melting.lol/*` -> contest, which would otherwise swallow it.
  "routes": [
    { "pattern": "skua.lol", "custom_domain": true },
    { "pattern": "skua.melting.lol", "custom_domain": true },
    { "pattern": "skua.melting.lol/*", "zone_name": "melting.lol" }
  ]
}
