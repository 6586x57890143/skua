DISCORD_BOT_TOKEN=
# Always passes the Admin tier, in every guild, whatever else is true.
SKUA_BOOTSTRAP_ADMIN_USER_ID=
# Optional. Unset runs without a database; /status says so.
SKUA_DATABASE_URL=
# Optional, loopback only, e.g. 127.0.0.1:6060. Used to capture default.pgo.
# Debugging only, never in prod: it also runs the flight recorder, which
# keeps the runtime tracer on and every goroutine paying for it.
SKUA_PPROF=
# Optional. /bird needs it: an API key from https://xeno-canto.org/account
SKUA_XENO_CANTO_KEY=
SKUA_LOG_LEVEL=info

# Optional. The Armada bridge runs only when SKUA_ARMADA_INVITE is set, and
# then every one of these but SKUA_ARMADA_BLOSSOM is required. All secrets.
# An invite link to the community, minted by someone who can grant the
# private channels it should read.
SKUA_ARMADA_INVITE=
# 64 lowercase hex. Every Discord member's Armada key derives from it, so
# changing it gives everyone a new identity there. openssl rand -hex 32
SKUA_ARMADA_MASTER_SECRET=
# skua's own Armada key, hex or nsec.
SKUA_ARMADA_PRIMARY_KEY=
# Which channels pair up: <discord channel id>=<armada channel id>, commas
# between pairs. Each channel may be in one pair.
SKUA_ARMADA_LINKS=
# Blossom servers to rehost Discord attachments on, in order. Unset sends
# Discord's links, which expire in about a day.
SKUA_ARMADA_BLOSSOM=
# Optional. A Klipy API key: a GIF picked in Discord crosses to Armada as the GIF
# itself, not a page link. Free from Klipy's developer portal.
SKUA_ARMADA_KLIPY_KEY=

# Optional, notify. youtube needs nothing. x and tiktok come through an
# RSSHub: COMPOSE_PROFILES=rsshub starts docker-compose.prod.yml's, at
# http://rsshub:1200, and x also needs TWITTER_AUTH_TOKEN, the auth_token
# cookie of a throwaway x account. twitch and kick each take a developer
# app's client credentials: dev.twitch.tv/console and
# kick.com/settings/developer. A platform left unset isn't offered.
SKUA_NOTIFY_RSSHUB=
COMPOSE_PROFILES=
TWITTER_AUTH_TOKEN=
SKUA_TWITCH_CLIENT_ID=
SKUA_TWITCH_CLIENT_SECRET=
SKUA_KICK_CLIENT_ID=
SKUA_KICK_CLIENT_SECRET=
# Optional, notify's push: twitch, kick and youtube call skua the moment
# something happens instead of waiting on a timer. COMPOSE_PROFILES gains
# tunnel (comma separated: rsshub,tunnel) and CLOUDFLARE_TUNNEL_TOKEN is the
# tunnel's token; SKUA_HOOKS_URL is its public hostname, https://hooks.skua.lol,
# routed to http://bot:8080. Kick's app needs its webhook URL set to
# https://hooks.skua.lol/kick. The secret signs twitch's and youtube's pushes:
# openssl rand -hex 32
SKUA_HOOKS_URL=
SKUA_HOOKS_SECRET=
CLOUDFLARE_TUNNEL_TOKEN=

# docker-compose.prod.yml's Postgres. SKUA_DATABASE_URL must match:
# postgres://skua:<password>@postgres:5432/skua?sslmode=disable
POSTGRES_USER=skua
POSTGRES_PASSWORD=changeme
